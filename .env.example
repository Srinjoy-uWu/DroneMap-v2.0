# ===========================================================================
# DroneMap v2.0 — Air-Gapped Offline Core & Local Ollama SLM Configuration
# ===========================================================================
# The entire DroneMap photogrammetry pipeline, local GPU vision stack
# (YOLOv8-seg, Neural Matcher, Depth Anything V2), 3D Mesh Completion Engine,
# and Web Studio Copilot operate 100% locally with zero commercial API keys.
# ===========================================================================

# Provider Selection: 'auto' | 'local' (Ollama localhost:11434) | 'offline'
DRONEMAP_LLM_PROVIDER=auto

# Local Ollama / OpenAI-Compatible Endpoint
DRONEMAP_LOCAL_LLM_URL=http://localhost:11434/v1

# Default Local SLM Model Name
DRONEMAP_LOCAL_MODEL=llama3.2:1b
