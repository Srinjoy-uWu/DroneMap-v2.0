# ===========================================================================
# DroneMap v2.0 — Environment Configuration
# ===========================================================================
# The DroneMap core photogrammetry pipeline is 100% functional offline.
# Providing an API key below enables the AI Booster Layer:
#   1. Multimodal Tactical Geospatial Intelligence Dossiers
#   2. Self-Healing Photogrammetry Diagnostics & Auto-Tuning
#   3. Natural Language 3D Spatial Copilot in Web Measurement Studio
# ===========================================================================

# Google Gemini API Key (Recommended for fast multimodal aerial reasoning)
GEMINI_API_KEY=

# OpenAI API Key (Alternative for GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=

# Anthropic Claude API Key (Alternative for Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=

# Active Provider: auto | gemini | openai | anthropic | offline
DRONEMAP_LLM_PROVIDER=auto

# Optional Model Override (Defaults: gemini-2.5-flash | gpt-4o-mini | claude-3-5-sonnet-20241022)
DRONEMAP_LLM_MODEL=
